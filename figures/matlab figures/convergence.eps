%AXGEndBitmap
GR
GR
GS
[0.12 0 0 0.12 540.00005 48] CT
[1 0 0 1 0 0] CT
N
-4500 -400 M
1124.999 -400 L
1124.999 1600 L
-4500 1600 L
-4500 -400 L
cp
clip
GS
0 0 translate
900 320 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 320
  /ImageMatrix [900 0 0 320 0 0]
  /Width 900
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
